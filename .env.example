# =============================================================================
# MedLens — Clinical Information Intelligence Environment Configuration
# =============================================================================

# Server Port & Authentication
PORT=5000
JWT_SECRET=medlens_secure_clinical_jwt_secret_key_2025

# -----------------------------------------------------------------------------
# OCR & Document Processing
# -----------------------------------------------------------------------------
# PDF text extraction uses 'pdf-parse'.
# Image OCR (PNG, JPG, JPEG) uses 'tesseract.js' with local offline traineddata.
# No external OCR API key is required.

# -----------------------------------------------------------------------------
# AI Extraction Provider (Choose Gemini or OpenAI)
# -----------------------------------------------------------------------------
# Google Gemini (Recommended — Supports Multimodal Vision for scanned PDFs and lab images)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# AI Model Name (Defaults to gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# (Optional) Alternative OpenAI API key if preferred (model: gpt-4o-mini)
OPENAI_API_KEY=
